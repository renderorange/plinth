[cluster]
name = "your-cluster-name"

[gateway]
listen = ":8000"
metrics_listen = ":9090"
health_interval = "3s"
health_fail_threshold = 3

[[nodes]]
ip = "192.168.1.100"
name = "gpu-node-1"
vllm_port = 8000
metrics_port = 9100

[[nodes]]
ip = "192.168.1.101"
name = "gpu-node-2"
vllm_port = 8000
metrics_port = 9100

[models]
default = "Qwen/Qwen2.5-32B-Instruct-Q4"

[[models.available]]
name = "Qwen/Qwen2.5-32B-Instruct-Q4"
pipeline_stages = 2

[[models.available]]
name = "Qwen/Qwen2.5-7B-Instruct"
pipeline_stages = 1

[cluster]
name = "your-cluster-name"

[gateway]
listen = ":8000"
metrics_listen = ":9090"
health_interval = "3s"
health_fail_threshold = 3

# Standalone nodes — each independently serves non-ring models (round-robin)
[[nodes]]
ip = "192.168.1.100"
name = "gpu-node-1"

[[nodes]]
ip = "192.168.1.101"
name = "gpu-node-2"

# Ring nodes — each independently serves the ring model; requests
# round-robin within the ring
[[nodes]]
ip = "192.168.1.102"
name = "gpu-node-3"
ring = "ring-a"

[[nodes]]
ip = "192.168.1.103"
name = "gpu-node-4"
ring = "ring-a"

[models]
default = "Qwen/Qwen2.5-7B-Instruct"

# Ring model — routed round-robin among the nodes in ring-a
[[models.available]]
name = "Qwen/Qwen2.5-32B-Instruct-Q4"
pipeline_stages = 2 # informational metadata; not enforced by the gateway
ring = "ring-a"

# Standalone model — routed round-robin among nodes without a ring
[[models.available]]
name = "Qwen/Qwen2.5-7B-Instruct"
pipeline_stages = 1

[provision]
weights_dir = "/var/lib/plinth/weights"
ssh_key = "~/.ssh/id_rsa"
# ssh_user = "root"
# ssh_port = 22
# ssh_host_key = "SHA256:..." # required for provision/weights push; value from: ssh-keyscan -t ed25519 <node-ip>
# gpu_exporter_bin = "./gpu-exporter"       # local path to gpu-exporter binary
# service_files_dir = "./scripts"            # directory containing .service files

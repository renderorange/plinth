[Unit]
Description=Distributed VRAM GPU Metrics Exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vram-exporter
Group=vram-exporter
# The exporter needs read access to /dev/nvidia*. The provision script adds the
# user to the video group; SupplementaryGroups keeps the unit correct regardless.
SupplementaryGroups=video
ExecStart=/usr/local/bin/gpu-exporter
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
